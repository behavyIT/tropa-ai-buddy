# Пример конфигурации (без секретов). Скопируйте в .env для docker compose.

# --- LLM (необязательно). Без ключа Тропа полностью работает в офлайн-режиме. ---
# Сервис: Anthropic Claude API (https://api.anthropic.com), модель по умолчанию claude-opus-5-5
LLM_PROVIDER=none            # none | anthropic
ANTHROPIC_API_KEY=           # ключ подключается только через переменную окружения
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low               # low | medium | high — глубина размышлений (латентность vs качество)
# ANTHROPIC_BASE_URL=        # для корпоративного прокси/шлюза
# LLM_SERVER_FALLBACK=true   # серверный fallback при отказе модели

# --- Безопасность ---
SESSION_SECRET=change-me-in-production   # обязателен при DEMO_MODE=false
CORP_TOKEN=local-corp-token              # сервисный токен Тропа → корпоративные MCP-сервисы
# SECURE_COOKIE=true                     # включить за HTTPS

# --- Демо ---
DEMO_MODE=true                            # машина времени, сброс демо, имитация сбоя сервисов
SIM_START=2026-11-09T09:30:00+03:00      # «первый день» стажировки
CORP_LATENCY=350ms                        # имитация задержки корпоративных сервисов

# --- Подключения (для локального запуска без Docker) ---
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/tropa?sslmode=disable
# REDIS_URL=redis://localhost:6379/0     # пусто → in-memory (одна реплика)
# CORP_MCP_URL=http://localhost:8090/mcp # пусто → корпоративные сервисы встроены в процесс
